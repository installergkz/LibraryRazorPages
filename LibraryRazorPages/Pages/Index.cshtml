@page
@model IndexModel
@{
    ViewData["Title"] = "Библиотека";
}

<p class="text-muted">Учёт книг, газет, журналов и т.д. и т.п.</p>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="alert alert-success mt-3">
        Добро пожаловать, <strong>@User.Identity.Name</strong>! Рады видеть вас в библиотеке.
    </div>
}

<a asp-page="/Books/Index" class="btn btn-primary">
    <i class="bi bi-book"></i> Книги
</a>