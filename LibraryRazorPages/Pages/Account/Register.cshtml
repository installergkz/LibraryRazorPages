@page
@model LibraryRazorPages.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Регистрация";
    Layout = "_LayoutLogin";
}

<div class="login-card">
    <div class="login-logo">
        <i class="bi bi-book"></i>
    </div>
    <h2>Библиотека</h2>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>
            
        <div class="mb-3">
            <label asp-for="RegisterForm.Login" class="form-label">Логин</label>
            <input asp-for="RegisterForm.Login" class="form-control" placeholder="Введите логин" />
            <span asp-validation-for="RegisterForm.Login" class="text-danger"></span>
        </div>
            
        <div class="mb-3">
            <label asp-for="RegisterForm.Password" class="form-label">Пароль</label>
            <input asp-for="RegisterForm.Password" class="form-control" placeholder="Введите пароль" type="password" />
            <span asp-validation-for="RegisterForm.Password" class="text-danger"></span>
        </div>
            
        <div class="mb-3">
            <label asp-for="RegisterForm.ConfirmPassword" class="form-label">Подтверждение пароля</label>
            <input asp-for="RegisterForm.ConfirmPassword" class="form-control" placeholder="Подтвердите пароль" type="password" />
            <span asp-validation-for="RegisterForm.ConfirmPassword" class="text-danger"></span>
        </div>
            
        <button type="submit" class="btn btn-primary btn-login">Зарегистрироваться</button>
    </form>
</div>
