<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Библиотека</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/lib/bootstrap/dist/css/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LibraryRazorPages.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        string IsActive(string pagePrefix) => currentPage.StartsWith(pagePrefix, StringComparison.OrdinalIgnoreCase) ? "active" : "";
        var booksOpen = currentPage.StartsWith("/Books", StringComparison.OrdinalIgnoreCase);
    }

    <div class="app-container">

        <!-- Сайдбар -->
        <aside class="app-sidebar">
            <a class="app-brand" asp-page="/Index">
                <i class="bi bi-book"></i>
                <span>Библиотека</span>
            </a>

            <nav class="app-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="app-nav__link @IsActive("/Index")" asp-page="/Index">
                        <i class="bi bi-house"></i>
                        <span>Главная</span>
                    </a>

                    <div class="app-nav__group">
                        <button type="button"
                                class="app-nav__link app-nav__toggle @(booksOpen ? "open" : "")"
                                data-bs-toggle="collapse"
                                data-bs-target="#booksSubmenu"
                                aria-expanded="@(booksOpen ? "true" : "false")">
                            <i class="bi bi-book"></i>
                            <span>Книги</span>
                            <i class="bi bi-chevron-down app-nav__arrow"></i>
                        </button>

                        <div class="collapse @(booksOpen ? "show" : "")" id="booksSubmenu">
                            <a class="app-nav__sublink @IsActive("/Books/Index")" asp-page="/Books/Index">
                                <i class="bi bi-list-ul"></i>
                                <span>Список книг</span>
                            </a>
                            <a class="app-nav__sublink @IsActive("/Books/Create")" asp-page="/Books/Create">
                                <i class="bi bi-plus-circle"></i>
                                <span>Добавить книгу</span>
                            </a>
                        </div>
                    </div>

                    <a class="app-nav__link @IsActive("/PublicationHouses")" asp-page="/PublicationHouses/Index">
                        <i class="bi bi-building"></i>
                        <span>Издательства</span>
                    </a>

                    <a class="app-nav__link @IsActive("/Reports")" asp-page="/Reports/Index">
                        <i class="bi bi-bar-chart"></i>
                        <span>Отчёты</span>
                    </a>

                    <a class="app-nav__link @IsActive("/Settings")" asp-page="/Settings/Index">
                        <i class="bi bi-gear"></i>
                        <span>Настройки</span>
                    </a>
                }
            </nav>
            <div class="app-sidebar__user mt-auto p-3 border-top border-secondary">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex flex-column mb-2">
                        <span class="text-light small opacity-75">Вы вошли как:</span>
                        <span class="text-white fw-bold text-truncate" title="@User.Identity.Name">
                            <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                        </span>
                    </div>
                    <form method="post" asp-page="/Account/Logout" class="w-100">
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                            <i class="bi bi-box-arrow-right me-1"></i>Выйти
                        </button>
                    </form>
                }
                else
                {
                    <a class="btn btn-primary btn-sm w-100" asp-page="/Account/Login">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Войти
                    </a>
                }
            </div>

            <footer class="app-sidebar__footer">
                © @DateTime.Now.Year — Library
            </footer>
        </aside>

        <!-- Основной контент (правая часть) -->
        <main class="app-content">
            <header class="app-content__header"><h1 class="app-content__title">@ViewData["Title"]</h1></header>

            <div class="app-content__body">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/delete-modal.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/dirty-form.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>